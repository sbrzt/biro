    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-bibliographic-list a biro:BibliographicList ;\n        co:element :my-bibliographic-reference ;\n        frbr:realizationOf :my-bibliographic-collection .\n    "
